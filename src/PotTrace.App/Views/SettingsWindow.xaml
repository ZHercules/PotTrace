<Window x:Class="PotTrace.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PotTrace · 设置" Width="520" Height="660" MinWidth="420" MinHeight="420" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI">
 <DockPanel Margin="16">
  <TextBlock DockPanel.Dock="Top" Text="统计设置" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <Button DockPanel.Dock="Right" Content="保存设置" Click="SaveClick"/>
   <TextBlock Text="播放记录仅保存在本机。" Foreground="{DynamicResource MutedBrush}"/>
  </DockPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Style="{StaticResource Surface}"><StackPanel>
    <TextBlock Text="播放采集" Style="{StaticResource SectionTitle}"/>
    <CheckBox x:Name="CaptureEnabled" Content="启用播放统计" Margin="0,10,0,6"/>
    <TextBlock Text="采集模式"/><ComboBox x:Name="Mode" AutomationProperties.Name="采集模式" Margin="0,4"><ComboBoxItem Content="精简 · 次数、实际播放时长"/><ComboBoxItem Content="详细 · 同时保存片段与时间轴"/></ComboBox>
    <TextBlock Text="从下一次观看会话生效。切换主窗口视图不会改变采集模式。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Surface}" Margin="0,8"><StackPanel>
    <TextBlock Text="外观与快捷键" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="界面主题" Margin="0,8,0,0"/><ComboBox x:Name="Theme" AutomationProperties.Name="界面主题" Margin="0,4"><ComboBoxItem Content="深色"/><ComboBoxItem Content="浅色"/></ComboBox>
    <TextBlock Text="打开统计的全局快捷键" Margin="0,6,0,0"/><TextBox x:Name="Shortcut" AutomationProperties.Name="全局快捷键" Margin="0,4"/>
    <TextBlock x:Name="ShortcutStatus" Foreground="{DynamicResource MutedBrush}"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Surface}"><StackPanel>
    <TextBlock Text="排除目录" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="每行输入一个完整路径。" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/>
    <TextBox x:Name="Exclusions" AutomationProperties.Name="排除目录" Margin="0" Height="76" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
