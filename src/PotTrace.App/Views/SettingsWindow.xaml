<Window x:Class="PotTrace.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PotTrace · 设置" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12" Width="500" Height="505" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="22"><TextBlock Text="采集模式" FontWeight="SemiBold"/><ComboBox x:Name="Mode" Margin="0,8,0,5"><ComboBoxItem Content="精简 · 次数、实际播放时长"/><ComboBoxItem Content="详细 · 同时保存片段与时间轴"/></ComboBox><TextBlock Text="从下一次观看会话生效，切换查看方式不会改变采集模式。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="界面主题" Margin="0,18,0,5"/><ComboBox x:Name="Theme"><ComboBoxItem Content="深色"/><ComboBoxItem Content="浅色"/></ComboBox><TextBlock Text="打开统计的全局快捷键" Margin="0,12,0,2"/><TextBox x:Name="Shortcut"/><TextBlock x:Name="ShortcutStatus" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="排除目录（每行一个完整路径）" Margin="0,18,0,4"/><TextBox x:Name="Exclusions" Height="92" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><TextBlock Text="播放记录仅保存在本机；关闭窗口后继续采集。" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,8"/><Button Content="保存设置" HorizontalAlignment="Right" Click="SaveClick"/></StackPanel>
</Window>
