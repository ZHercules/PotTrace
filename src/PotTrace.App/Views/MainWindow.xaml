<Window x:Class="PotTrace.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PotTrace.App.Controls" Title="PotTrace · 播放统计" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12" Width="1180" Height="780" MinWidth="860" MinHeight="580" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="ViewChoice" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Chip" Padding="14,5" Background="Transparent" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <DockPanel Margin="16,10,16,12">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
   <Menu DockPanel.Dock="Right" VerticalAlignment="Center"><MenuItem Header="文件"><MenuItem Header="导出当前筛选…" Click="ExportClick"/><MenuItem Header="备份数据库…" Click="BackupClick"/><MenuItem Header="恢复备份…" Click="RestoreClick"/></MenuItem><MenuItem Header="设置" Click="SettingsClick"/><MenuItem Header="规则说明" Click="RulesClick"/></Menu>
   <StackPanel Orientation="Horizontal"><TextBlock Text="PotTrace" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/><TextBlock Text="播放统计" FontSize="22" FontWeight="SemiBold"/></StackPanel>
  </DockPanel>
  <Border DockPanel.Dock="Top" Style="{StaticResource Surface}" Padding="10,6" Margin="0,0,0,10">
   <WrapPanel>
    <TextBlock Text="文件名" Margin="2,0,4,0"/><TextBox x:Name="Search" Width="175" AutomationProperties.Name="搜索文件名" ToolTip="按完整文件名搜索，按回车应用" KeyDown="SearchKey"/>
    <TextBlock Text="打开日期" Margin="12,0,6,0"/><DatePicker x:Name="FromDate" Width="120" AutomationProperties.Name="开始日期"/><TextBlock Text="至" Margin="6,0"/><DatePicker x:Name="ToDate" Width="120" AutomationProperties.Name="结束日期"/>
    <Button Content="筛选 / 刷新" Click="RefreshClick" Margin="12,2,0,2"/>
   </WrapPanel>
  </Border>
  <DockPanel DockPanel.Dock="Bottom" Margin="2,10,0,0">
   <Button DockPanel.Dock="Right" x:Name="PauseButton" Content="暂停统计" Click="PauseClick" VerticalAlignment="Center"/>
   <StackPanel><TextBlock x:Name="StatusText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CurrentText" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
  </DockPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="MovieColumn" Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Surface}">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9">
      <Border DockPanel.Dock="Right" CornerRadius="6" Background="{DynamicResource WindowBrush}" Padding="2" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal"><RadioButton GroupName="View" Style="{StaticResource ViewChoice}" Content="精简" IsChecked="True" Checked="ViewChanged"/><RadioButton x:Name="DetailedChoice" GroupName="View" Style="{StaticResource ViewChoice}" Content="详细" Checked="ViewChanged"/></StackPanel>
      </Border>
      <StackPanel><TextBlock Text="影片记录" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SummaryText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
     </DockPanel>
     <WrapPanel DockPanel.Dock="Bottom" Margin="0,7,0,0"><Button Content="上一页" Click="PreviousClick"/><TextBlock x:Name="PageText" Margin="6,0"/><Button Content="下一页" Click="NextClick"/><Button Content="删除所选影片记录…" Click="DeleteClick"/></WrapPanel>
    <Grid><DataGrid x:Name="Movies" SelectionChanged="MovieSelected"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="文件名" Binding="{Binding FileName}" Width="*" MinWidth="120"/><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="次数" Binding="{Binding OpenCount}" Width="55"/><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="累计播放" Binding="{Binding Played}" Width="95"/><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="最近打开" Binding="{Binding Last}" Width="145"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyText" Text="暂无记录。影片停留超过 10 秒后计入。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/></Grid>
    </DockPanel>
   </Border>
   <Border Grid.Column="1" x:Name="DetailPanel" Style="{StaticResource Surface}" Margin="10,0,0,0" Visibility="Collapsed">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid Margin="0,0,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="116"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="148"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,5"><TextBlock Text="观看会话" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="Sources" SelectionChanged="SourceChanged" MinWidth="140" MaxWidth="390" HorizontalAlignment="Right" ToolTip="热度按来源分别统计"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></DockPanel>
    <DataGrid Grid.Row="1" x:Name="Sessions" SelectionChanged="SessionSelected"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="打开时间" Binding="{Binding Started}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="实际播放" Binding="{Binding Played}" Width="90"/><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="模式" Binding="{Binding Mode}" Width="55"/></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="2" x:Name="Notice" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7"/>
    <DockPanel Grid.Row="3" Margin="0,8,0,0"><DockPanel DockPanel.Dock="Top" Margin="0,0,0,4"><TextBlock Text="现实时间轴" Style="{StaticResource SectionTitle}"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock Text="缩放" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0"/><Slider x:Name="Zoom" Minimum="1" Maximum="8" Value="1" Width="92" ValueChanged="ZoomChanged"/></StackPanel></DockPanel><ScrollViewer x:Name="TimelineViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ScrollChanged="TimelineScrollChanged"><local:TimelineControl x:Name="Timeline" Height="74"/></ScrollViewer></DockPanel>
    <DockPanel Grid.Row="4" Margin="0,8,0,0"><TextBlock Text="片段热度" Style="{StaticResource SectionTitle}"/><TextBlock Text="覆盖次数 · 每秒采样" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
    <local:HeatLineChart Grid.Row="5" x:Name="Heat" Height="108" AutomationProperties.Name="片段热度折线图" AutomationProperties.HelpText="悬停查看覆盖次数，也可聚焦后用左右方向键逐秒查看。"/>
    <TabControl Grid.Row="6" Margin="0,6,0,0"><TabItem Header="播放片段"><DataGrid x:Name="Segments"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="现实开始时间" Binding="{Binding WallStart}" Width="150"/><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="影片区间" Binding="{Binding MediaRange}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="实际播放" Binding="{Binding Played}" Width="85"/><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="结束原因" Binding="{Binding Reason}" Width="110"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="高频区间"><DataGrid x:Name="Hotspots" SelectionChanged="HotspotSelected"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="影片区间" Binding="{Binding Range}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="覆盖次数" Binding="{Binding Count}" Width="90"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
     </Grid>
    </ScrollViewer>
   </Border>
  </Grid>
 </DockPanel>
</Window>
