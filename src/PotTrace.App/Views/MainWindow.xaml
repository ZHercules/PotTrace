<Window x:Class="PotTrace.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PotTrace.App.Controls" Title="PotTrace · 播放统计" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12" Width="1180" Height="780" MinWidth="860" MinHeight="580" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="10">
  <Menu DockPanel.Dock="Top" Margin="0,0,0,5"><MenuItem Header="文件"><MenuItem Header="导出当前筛选…" Click="ExportClick"/><MenuItem Header="备份数据库…" Click="BackupClick"/><MenuItem Header="恢复备份…" Click="RestoreClick"/></MenuItem><MenuItem Header="设置" Click="SettingsClick"/><MenuItem Header="规则说明" Click="RulesClick"/></Menu>
  <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button Content="精简" Click="SimpleClick"/><Button Content="详细" Click="DetailedClick"/><TextBox x:Name="Search" Width="190" ToolTip="按完整文件名搜索" KeyDown="SearchKey"/><TextBlock Text="打开日期" Margin="7,0"/><DatePicker x:Name="FromDate" Width="120"/><TextBlock Text=" — "/><DatePicker x:Name="ToDate" Width="120"/><Button Content="筛选 / 刷新" Click="RefreshClick"/><Button x:Name="PauseButton" Content="暂停统计" Click="PauseClick"/></WrapPanel>
  <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="2,7,2,0"><StackPanel><TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CurrentText" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Border>
  <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition x:Name="MovieColumn" Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,6,0"><DockPanel DockPanel.Dock="Top" Margin="2,0,0,7"><TextBlock Text="影片" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0"><Button Content="上一页" Click="PreviousClick"/><Button Content="下一页" Click="NextClick"/><TextBlock x:Name="PageText" Margin="8,0"/><Button Content="删除所选影片记录…" Click="DeleteClick"/></StackPanel>
    <Grid><DataGrid x:Name="Movies" SelectionChanged="MovieSelected"><DataGrid.Columns><DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*" MinWidth="120"/><DataGridTextColumn Header="次数" Binding="{Binding OpenCount}" Width="55"/><DataGridTextColumn Header="累计播放" Binding="{Binding Played}" Width="95"/><DataGridTextColumn Header="最近打开" Binding="{Binding Last}" Width="145"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyText" Text="暂无记录。影片停留超过 10 秒后计入。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/></Grid>
   </DockPanel>
   <Grid Grid.Column="1" x:Name="DetailPanel" Visibility="Collapsed" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/><RowDefinition Height="135"/><RowDefinition Height="Auto"/><RowDefinition Height="85"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,5"><TextBlock Text="观看会话" FontWeight="SemiBold"/><ComboBox x:Name="Sources" SelectionChanged="SourceChanged" MinWidth="220" MaxWidth="390" HorizontalAlignment="Right" ToolTip="热度按来源分别统计"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></DockPanel>
    <DataGrid Grid.Row="1" x:Name="Sessions" SelectionChanged="SessionSelected"><DataGrid.Columns><DataGridTextColumn Header="打开时间" Binding="{Binding Started}" Width="*"/><DataGridTextColumn Header="实际播放" Binding="{Binding Played}" Width="90"/><DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="55"/></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="2" x:Name="Notice" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7"/>
    <DockPanel Grid.Row="3"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBlock Text="现实时间轴"/><TextBlock Text="   缩放 " Foreground="{DynamicResource MutedBrush}"/><Slider x:Name="Zoom" Minimum="1" Maximum="8" Value="1" Width="120" ValueChanged="ZoomChanged"/></StackPanel><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><local:TimelineControl x:Name="Timeline" Height="96"/></ScrollViewer></DockPanel>
    <TextBlock Grid.Row="4" Text="影片位置 · 观看覆盖次数" Margin="0,9,0,3"/>
    <local:TimelineControl Grid.Row="5" x:Name="Heat" IsHeat="True" Height="80"/>
    <TabControl Grid.Row="6" Margin="0,6,0,0"><TabItem Header="播放片段"><DataGrid x:Name="Segments"><DataGrid.Columns><DataGridTextColumn Header="现实开始时间" Binding="{Binding WallStart}" Width="150"/><DataGridTextColumn Header="影片区间" Binding="{Binding MediaRange}" Width="*"/><DataGridTextColumn Header="实际播放" Binding="{Binding Played}" Width="85"/><DataGridTextColumn Header="结束原因" Binding="{Binding Reason}" Width="110"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="高频区间"><DataGrid x:Name="Hotspots" SelectionChanged="HotspotSelected"><DataGrid.Columns><DataGridTextColumn Header="影片区间" Binding="{Binding Range}" Width="*"/><DataGridTextColumn Header="覆盖次数" Binding="{Binding Count}" Width="90"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
